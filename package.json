{
  "name": "yara-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Yara Al-Haddad — UI/UX portfolio (Figma → HTML + Tailwind)",
  "scripts": {
    "dev": "npm run dev:css",
    "dev:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./assets/css/main.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./assets/css/main.css --minify",
    "serve": "npx serve .",
    "start": "npm run build:css && npm run serve"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "serve": "^14.2.4",
    "tailwindcss": "^4.1.12"
  }
}
